APP_PORT=8000
SCANNER_TOKEN=replace-with-a-long-random-secret
ADMIN_USERNAME=replace-with-a-local-admin-name
ADMIN_PASSWORD=replace-with-a-different-long-random-secret

# Optional provider credentials. Without them, scanning works but feed refresh is unavailable.
PHISHTANK_APP_KEY=
URLHAUS_AUTH_KEY=

# Optional cross-instance sharing key for HMAC-SHA256 signed threat export/import.
SHARING_KEY=

# Optional report auto-approval threshold (e.g. 3). If unset, all reports require manual review.
REPORT_AUTO_APPROVE_THRESHOLD=
